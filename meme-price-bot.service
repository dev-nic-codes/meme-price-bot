[Unit]
Description=Meme Price Dashboard Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/srv/projects/meme-price-bot
ExecStart=/srv/projects/meme-price-bot/.venv/bin/python -m src.telegram_bot
Restart=always
RestartSec=10
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
